# Copy outside the repository to /etc/stone-wealth/backup.env with mode 0600.
# Both the website and backup task must use these same database/backup settings.
ASSET_TRACKER_DB_PATH=/var/lib/stone-wealth/data/database.sqlite
ASSET_TRACKER_BACKUP_DIR=/var/backups/stone-wealth
ASSET_TRACKER_BACKUP_KEEP=30
ASSET_TRACKER_BACKUP_FRESH_HOURS=36
