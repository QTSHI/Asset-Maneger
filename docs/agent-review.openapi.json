{
  "openapi": "3.1.0",
  "info": {
    "title": "Stone Wealth Agent 审核 API",
    "version": "1.0.0",
    "description": "供已登录的网站用户管理 Agent 凭证和审核资产修改建议。Agent 本身只连接 /mcp，不能调用这些审核接口。"
  },
  "servers": [{ "url": "/api/v2" }],
  "security": [{ "ssoToken": [] }],
  "paths": {
    "/agent/proposals": {
      "get": {
        "operationId": "listAgentAssetProposals",
        "summary": "列出当前 SSO 用户的资产修改建议",
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/ProposalStatus" } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "pageSize", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } }
        ],
        "responses": {
          "200": {
            "description": "修改建议列表",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["data", "meta"],
              "properties": {
                "data": { "type": "array", "items": { "$ref": "#/components/schemas/Proposal" } },
                "meta": { "type": "object", "required": ["total", "page", "pageSize"], "properties": {
                  "total": { "type": "integer" }, "page": { "type": "integer" }, "pageSize": { "type": "integer" }
                } }
              }
            } } }
          }
        }
      }
    },
    "/agent/proposals/{id}/approve": {
      "post": {
        "operationId": "approveAgentAssetProposal",
        "summary": "由当前 SSO 用户确认资产修改",
        "description": "服务器在同一事务中核对资产是否仍与建议创建时一致，然后写入并记录审计。Agent 凭证不能调用。",
        "parameters": [{ "$ref": "#/components/parameters/ProposalId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/ProposalResult" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/agent/proposals/{id}/reject": {
      "post": {
        "operationId": "rejectAgentAssetProposal",
        "summary": "由当前 SSO 用户拒绝资产修改",
        "parameters": [{ "$ref": "#/components/parameters/ProposalId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/ProposalResult" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/agent/keys": {
      "get": {
        "operationId": "listAgentKeys",
        "summary": "列出当前 SSO 用户签发的 Agent 凭证元信息",
        "responses": {
          "200": {
            "description": "凭证元信息；不返回完整凭证",
            "content": { "application/json": { "schema": {
              "type": "object", "required": ["data", "meta"],
              "properties": {
                "data": { "type": "array", "items": { "$ref": "#/components/schemas/KeyMetadata" } },
                "meta": { "type": "object", "properties": { "total": { "type": "integer" } } }
              }
            } } }
          }
        }
      },
      "post": {
        "operationId": "createAgentKey",
        "summary": "签发只显示一次的 Agent 凭证",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "required": ["label"], "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "expiresInDays": { "type": "integer", "minimum": 1, "maximum": 365, "default": 90 }
            }
          } } }
        },
        "responses": {
          "201": {
            "description": "凭证只在此响应中出现一次",
            "content": { "application/json": { "schema": {
              "type": "object", "required": ["data"],
              "properties": { "data": {
                "allOf": [
                  { "$ref": "#/components/schemas/KeyMetadata" },
                  { "type": "object", "required": ["token"], "properties": { "token": { "type": "string" } } }
                ]
              } }
            } } }
          }
        }
      }
    },
    "/agent/keys/{id}": {
      "delete": {
        "operationId": "revokeAgentKey",
        "summary": "撤销当前 SSO 用户的一枚 Agent 凭证",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "responses": {
          "204": { "description": "已撤销" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ssoToken": {
        "type": "apiKey", "in": "header", "name": "X-Auth-Token",
        "description": "现有统一登录的会话令牌。浏览器也可使用现有 session cookie；Agent 凭证不能用于此处。"
      }
    },
    "parameters": {
      "ProposalId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }
    },
    "schemas": {
      "ProposalStatus": { "type": "string", "enum": ["pending", "approved", "rejected", "conflicted"] },
      "Proposal": {
        "type": "object",
        "required": ["id", "assetId", "status", "asset", "changes", "createdAt"],
        "properties": {
          "id": { "type": "integer" },
          "assetId": { "type": "integer" },
          "agentKeyId": { "type": ["integer", "null"] },
          "agentLabel": { "type": ["string", "null"] },
          "status": { "$ref": "#/components/schemas/ProposalStatus" },
          "asset": {
            "type": "object",
            "required": ["id", "code", "name", "accountName", "currencyCode", "assetTypeName"],
            "properties": {
              "id": { "type": "integer" }, "code": { "type": ["string", "null"] }, "name": { "type": "string" },
              "accountName": { "type": ["string", "null"] }, "currencyCode": { "type": ["string", "null"] },
              "assetTypeName": { "type": ["string", "null"] }
            }
          },
          "changes": {
            "type": "array", "items": { "type": "object", "required": ["field", "before", "after"],
              "properties": {
                "field": { "type": "string" }, "before": {}, "after": {}
              }
            }
          },
          "createdAt": { "type": "string" },
          "reviewedAt": { "type": ["string", "null"] },
          "reviewerUsername": { "type": ["string", "null"] }
        }
      },
      "KeyMetadata": {
        "type": "object",
        "required": ["id", "label", "tokenPrefix", "createdAt", "expiresAt"],
        "properties": {
          "id": { "type": "integer" }, "label": { "type": "string" },
          "tokenPrefix": { "type": "string" }, "createdAt": { "type": "string" },
          "expiresAt": { "type": "string" }, "revokedAt": { "type": ["string", "null"] },
          "lastUsedAt": { "type": ["string", "null"] }
        }
      }
    },
    "responses": {
      "ProposalResult": {
        "description": "审核后的建议",
        "content": { "application/json": { "schema": {
          "type": "object", "required": ["data"],
          "properties": { "data": { "$ref": "#/components/schemas/Proposal" } }
        } } }
      },
      "NotFound": { "description": "记录不存在或不属于当前用户" },
      "Conflict": { "description": "建议已处理或资产内容已变化，需要重新提交建议" }
    }
  }
}
